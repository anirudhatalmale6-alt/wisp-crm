<%- include('partials/header', { currentPage: 'dashboard', pageTitle: 'Dashboard' }) %>

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <a href="/clients" class="bg-white rounded-xl shadow-sm border p-5 hover:shadow-md hover:border-blue-300 transition-all cursor-pointer block">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Total Clientes</p>
        <p class="text-2xl font-bold text-gray-800"><%= totalClients %></p>
      </div>
      <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
        <i class="fas fa-users text-blue-600 text-xl"></i>
      </div>
    </div>
    <div class="mt-2 text-xs">
      <span class="text-green-600"><%= activeClients %> activos</span> &middot;
      <span class="text-red-600"><%= suspendedClients %> suspendidos</span>
    </div>
  </a>

  <a href="/payments" class="bg-white rounded-xl shadow-sm border p-5 hover:shadow-md hover:border-green-300 transition-all cursor-pointer block">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Ingresos del Mes</p>
        <p class="text-2xl font-bold text-green-600"><%= settings.currency || '$' %><%= monthlyIncome.toLocaleString('es', {minimumFractionDigits: 2}) %></p>
      </div>
      <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
        <i class="fas fa-dollar-sign text-green-600 text-xl"></i>
      </div>
    </div>
  </a>

  <a href="#" onclick="document.getElementById('pendingClientsList').classList.toggle('hidden');return false;" class="bg-white rounded-xl shadow-sm border p-5 hover:shadow-md hover:border-orange-300 transition-all cursor-pointer block">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Facturas Pendientes</p>
        <p class="text-2xl font-bold text-orange-600"><%= pendingInvoices %></p>
      </div>
      <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
        <i class="fas fa-file-invoice text-orange-600 text-xl"></i>
      </div>
    </div>
    <div class="mt-2 text-xs text-gray-500">
      Monto: <%= settings.currency || '$' %><%= pendingAmount.toLocaleString('es', {minimumFractionDigits: 2}) %>
      <span class="text-orange-500 ml-1"><i class="fas fa-chevron-down"></i> Ver clientes</span>
    </div>
  </a>

  <a href="/invoices?status=overdue" class="bg-white rounded-xl shadow-sm border p-5 hover:shadow-md hover:border-red-300 transition-all cursor-pointer block">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Facturas Vencidas</p>
        <p class="text-2xl font-bold text-red-600"><%= overdueInvoices %></p>
      </div>
      <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
        <i class="fas fa-exclamation-triangle text-red-600 text-xl"></i>
      </div>
    </div>
  </a>
</div>

<!-- Clients with Pending Invoices (toggleable) -->
<div id="pendingClientsList" class="hidden bg-white rounded-xl shadow-sm border mb-6 overflow-hidden">
  <div class="px-5 py-4 border-b bg-orange-50 flex items-center justify-between">
    <h3 class="font-semibold text-gray-700"><i class="fas fa-file-invoice text-orange-500 mr-2"></i>Clientes con Facturas Pendientes (<%= clientsPendingInvoices.length %>)</h3>
    <button onclick="document.getElementById('pendingClientsList').classList.add('hidden')" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
  </div>
  <% if (clientsPendingInvoices.length === 0) { %>
    <div class="p-5 text-center text-gray-400 text-sm">No hay clientes con facturas pendientes</div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 border-b text-left">
            <th class="px-4 py-3 font-semibold text-gray-600">Cliente</th>
            <th class="px-4 py-3 font-semibold text-gray-600">Telefono</th>
            <th class="px-4 py-3 font-semibold text-gray-600 text-center">Facturas</th>
            <th class="px-4 py-3 font-semibold text-gray-600 text-right">Monto Pendiente</th>
            <th class="px-4 py-3 font-semibold text-gray-600 text-center">Estado</th>
            <th class="px-4 py-3 font-semibold text-gray-600 text-center">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% clientsPendingInvoices.forEach(c => { %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <a href="/clients/<%= c.id %>" class="font-medium text-gray-800 hover:text-wisp-600"><%= c.first_name %> <%= c.last_name %></a>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= c.phone %></td>
            <td class="px-4 py-3 text-center"><span class="bg-orange-100 text-orange-700 text-xs font-semibold px-2 py-0.5 rounded-full"><%= c.invoice_count %></span></td>
            <td class="px-4 py-3 text-right font-semibold text-red-600"><%= settings.currency || '$' %><%= Number(c.total_pending).toFixed(2) %></td>
            <td class="px-4 py-3 text-center">
              <% if (c.status === 'active') { %>
                <span class="bg-green-100 text-green-700 text-xs font-semibold px-2 py-0.5 rounded-full">Activo</span>
              <% } else if (c.status === 'suspended') { %>
                <span class="bg-red-100 text-red-700 text-xs font-semibold px-2 py-0.5 rounded-full">Suspendido</span>
              <% } else { %>
                <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-2 py-0.5 rounded-full">Inactivo</span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-center">
              <a href="/payments/new?client_id=<%= c.id %>" class="text-emerald-600 hover:text-emerald-700 text-sm font-medium"><i class="fas fa-dollar-sign mr-1"></i>Pago</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- New Clients This Month (toggleable) -->
<div id="newClientsList" class="hidden bg-white rounded-xl shadow-sm border mb-6 overflow-hidden">
  <div class="px-5 py-4 border-b bg-teal-50 flex items-center justify-between">
    <h3 class="font-semibold text-gray-700"><i class="fas fa-user-plus text-teal-500 mr-2"></i>Clientes Nuevos Este Mes (<%= newClientsMonthList.length %>)</h3>
    <button onclick="document.getElementById('newClientsList').classList.add('hidden')" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
  </div>
  <% if (newClientsMonthList.length === 0) { %>
    <div class="p-5 text-center text-gray-400 text-sm">No hay clientes nuevos este mes</div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 border-b text-left">
            <th class="px-4 py-3 font-semibold text-gray-600">Cliente</th>
            <th class="px-4 py-3 font-semibold text-gray-600">Telefono</th>
            <th class="px-4 py-3 font-semibold text-gray-600">Plan</th>
            <th class="px-4 py-3 font-semibold text-gray-600">Fecha Registro</th>
            <th class="px-4 py-3 font-semibold text-gray-600 text-center">Estado</th>
            <th class="px-4 py-3 font-semibold text-gray-600 text-center">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% newClientsMonthList.forEach(c => { %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <a href="/clients/<%= c.id %>" class="font-medium text-gray-800 hover:text-wisp-600"><%= c.first_name %> <%= c.last_name %></a>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= c.phone %></td>
            <td class="px-4 py-3 text-gray-600"><%= c.plan_name || 'Sin plan' %></td>
            <td class="px-4 py-3 text-gray-600"><%= c.created_at ? c.created_at.substring(0, 10) : '' %></td>
            <td class="px-4 py-3 text-center">
              <% if (c.status === 'active') { %>
                <span class="bg-green-100 text-green-700 text-xs font-semibold px-2 py-0.5 rounded-full">Activo</span>
              <% } else if (c.status === 'suspended') { %>
                <span class="bg-red-100 text-red-700 text-xs font-semibold px-2 py-0.5 rounded-full">Suspendido</span>
              <% } else { %>
                <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-2 py-0.5 rounded-full"><%= c.status %></span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-center">
              <a href="/clients/<%= c.id %>" class="text-wisp-600 hover:text-wisp-700 text-sm font-medium"><i class="fas fa-eye mr-1"></i>Ver</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Stats Cards Row 2 -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <a href="/payments" class="bg-white rounded-xl shadow-sm border-2 border-emerald-200 p-5 hover:shadow-md hover:border-emerald-400 transition-all cursor-pointer block">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Ingreso de Hoy</p>
        <p class="text-2xl font-bold text-emerald-600"><%= settings.currency || '$' %><%= todayIncome.toLocaleString('es', {minimumFractionDigits: 2}) %></p>
      </div>
      <div class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center">
        <i class="fas fa-calendar-day text-emerald-600 text-xl"></i>
      </div>
    </div>
    <div class="mt-2 text-xs text-gray-500">
      <%= todayPaymentsCount %> <%= todayPaymentsCount === 1 ? 'pago registrado' : 'pagos registrados' %> hoy
    </div>
  </a>

  <a href="/payments" class="bg-white rounded-xl shadow-sm border p-5 hover:shadow-md hover:border-purple-300 transition-all cursor-pointer block">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Ingreso Mes Anterior</p>
        <p class="text-2xl font-bold text-purple-600"><%= settings.currency || '$' %><%= prevMonthIncome.toLocaleString('es', {minimumFractionDigits: 2}) %></p>
      </div>
      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
        <i class="fas fa-history text-purple-600 text-xl"></i>
      </div>
    </div>
  </a>

  <a href="/clients?status=suspended" class="bg-white rounded-xl shadow-sm border p-5 hover:shadow-md hover:border-red-300 transition-all cursor-pointer block">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Clientes Suspendidos</p>
        <p class="text-2xl font-bold text-red-600"><%= suspendedClients %></p>
      </div>
      <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
        <i class="fas fa-user-slash text-red-600 text-xl"></i>
      </div>
    </div>
  </a>

  <a href="#" onclick="document.getElementById('newClientsList').classList.toggle('hidden');return false;" class="bg-white rounded-xl shadow-sm border p-5 hover:shadow-md hover:border-teal-300 transition-all cursor-pointer block">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Nuevos Este Mes</p>
        <p class="text-2xl font-bold text-teal-600"><%= newClientsMonth %></p>
      </div>
      <div class="w-12 h-12 bg-teal-100 rounded-lg flex items-center justify-center">
        <i class="fas fa-user-plus text-teal-600 text-xl"></i>
      </div>
    </div>
    <div class="mt-2 text-xs text-gray-500">
      <span class="text-teal-500"><i class="fas fa-chevron-down"></i> Ver clientes</span>
    </div>
  </a>
</div>

<!-- Tickets Card -->
<% if (openTickets > 0) { %>
<a href="/tickets?status=abierto" class="block bg-white rounded-xl shadow-sm border p-5 mb-6 hover:shadow-md hover:border-orange-300 transition-all">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
        <i class="fas fa-ticket-alt text-orange-600 text-xl"></i>
      </div>
      <div>
        <p class="text-sm text-gray-500">Tickets Abiertos</p>
        <p class="text-2xl font-bold text-orange-600"><%= openTickets %></p>
      </div>
    </div>
    <span class="text-orange-500 text-sm"><i class="fas fa-arrow-right"></i></span>
  </div>
</a>
<% } %>

<!-- Quick Actions -->
<div class="bg-white rounded-xl shadow-sm border p-5 mb-6">
  <h3 class="font-semibold text-gray-700 mb-3">Acciones Rápidas</h3>
  <div class="flex flex-wrap gap-3">
    <a href="/clients/new" class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">
      <i class="fas fa-user-plus mr-1"></i> Nuevo Cliente
    </a>
    <a href="/payments/new" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">
      <i class="fas fa-money-bill mr-1"></i> Registrar Pago
    </a>
    <a href="/tickets/new" class="bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">
      <i class="fas fa-ticket-alt mr-1"></i> Nuevo Ticket
    </a>
    <form method="POST" action="/whatsapp/send-reminders" class="inline">
      <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">
        <i class="fab fa-whatsapp mr-1"></i> Enviar Recordatorios
      </button>
    </form>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Overdue clients -->
  <div class="bg-white rounded-xl shadow-sm border">
    <div class="p-5 border-b">
      <h3 class="font-semibold text-gray-700"><i class="fas fa-exclamation-circle text-red-500 mr-2"></i>Clientes con Mora</h3>
    </div>
    <div class="p-5">
      <% if (overdueClients.length === 0) { %>
        <p class="text-gray-400 text-sm text-center py-4">No hay clientes con mora</p>
      <% } else { %>
        <div class="space-y-3">
          <% overdueClients.forEach(c => { %>
          <div class="flex items-center justify-between p-3 bg-red-50 rounded-lg">
            <div>
              <p class="font-medium text-sm"><%= c.first_name %> <%= c.last_name %></p>
              <p class="text-xs text-gray-500"><%= c.phone %> &middot; Vence: <%= c.due_date %></p>
            </div>
            <div class="text-right">
              <p class="font-semibold text-red-600 text-sm"><%= settings.currency || '$' %><%= c.total.toFixed(2) %></p>
              <span class="text-xs px-2 py-0.5 rounded-full <%= c.status === 'suspended' ? 'bg-red-200 text-red-700' : 'bg-yellow-200 text-yellow-700' %>">
                <%= c.status === 'suspended' ? 'Suspendido' : 'Activo' %>
              </span>
            </div>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Recent payments -->
  <div class="bg-white rounded-xl shadow-sm border">
    <div class="p-5 border-b">
      <h3 class="font-semibold text-gray-700"><i class="fas fa-money-bill-wave text-green-500 mr-2"></i>Pagos Recientes</h3>
    </div>
    <div class="p-5">
      <% if (recentPayments.length === 0) { %>
        <p class="text-gray-400 text-sm text-center py-4">No hay pagos registrados</p>
      <% } else { %>
        <div class="space-y-3">
          <% recentPayments.forEach(p => { %>
          <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
            <div>
              <p class="font-medium text-sm"><%= p.first_name %> <%= p.last_name %></p>
              <p class="text-xs text-gray-500"><%= p.created_at %></p>
            </div>
            <p class="font-semibold text-green-600"><%= settings.currency || '$' %><%= p.amount.toFixed(2) %></p>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Secretary Payments Today -->
<% if (secretaryPayments && secretaryPayments.length > 0) { %>
<div class="bg-white rounded-xl shadow-sm border mt-6">
  <div class="p-5 border-b flex items-center justify-between">
    <h3 class="font-semibold text-gray-700"><i class="fas fa-user-clock text-purple-500 mr-2"></i>Cobros de Secretaria - Hoy</h3>
    <span class="bg-purple-100 text-purple-700 text-sm font-semibold px-3 py-1 rounded-full">
      Total: <%= settings.currency || '$' %><%= secretaryTotal.toLocaleString('es', {minimumFractionDigits: 2}) %>
    </span>
  </div>
  <div class="p-5">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b">
            <th class="pb-2 font-medium">Cliente</th>
            <th class="pb-2 font-medium">Monto</th>
            <th class="pb-2 font-medium">Metodo</th>
            <th class="pb-2 font-medium">Registrado por</th>
            <th class="pb-2 font-medium">Hora</th>
          </tr>
        </thead>
        <tbody>
          <% secretaryPayments.forEach(p => { %>
          <tr class="border-b border-gray-100">
            <td class="py-2"><%= p.first_name %> <%= p.last_name %></td>
            <td class="py-2 font-semibold text-green-600"><%= settings.currency || '$' %><%= p.amount.toFixed(2) %></td>
            <td class="py-2 capitalize"><%= p.payment_method %></td>
            <td class="py-2"><%= p.registered_by || 'N/A' %></td>
            <td class="py-2 text-gray-500"><%= p.created_at %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>

<!-- Offline Clients (loaded via AJAX from MikroTik) -->
<div class="bg-white rounded-xl shadow-sm border mt-6" id="offlineSection">
  <div class="p-5 border-b flex items-center justify-between">
    <h3 class="font-semibold text-gray-700"><i class="fas fa-wifi text-gray-400 mr-2"></i>Estado de Conexion PPPoE</h3>
    <div class="flex items-center gap-3">
      <span id="onlineCount" class="text-sm text-gray-400"></span>
      <button onclick="loadOfflineClients()" class="text-wisp-600 hover:text-wisp-700 text-sm"><i class="fas fa-sync-alt"></i></button>
    </div>
  </div>
  <div class="p-5" id="offlineContent">
    <div class="text-center py-4">
      <i class="fas fa-spinner fa-spin text-gray-300 text-xl"></i>
      <p class="text-sm text-gray-400 mt-2">Consultando MikroTik...</p>
    </div>
  </div>
</div>

<script>
function loadOfflineClients() {
  var content = document.getElementById('offlineContent');
  var countEl = document.getElementById('onlineCount');
  content.innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin text-gray-300 text-xl"></i><p class="text-sm text-gray-400 mt-2">Consultando MikroTik...</p></div>';

  fetch('/mikrotik/api/offline-clients')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.error) {
        content.innerHTML = '<p class="text-sm text-gray-400 text-center py-4"><i class="fas fa-exclamation-triangle text-yellow-500 mr-1"></i>' + data.error + '</p>';
        return;
      }

      var ageText = '';
      if (data.ageMinutes !== null && data.ageMinutes !== undefined) {
        ageText = data.ageMinutes < 1 ? ' (hace menos de 1 min)' : ' (hace ' + data.ageMinutes + ' min)';
      }
      countEl.innerHTML = '<span class="bg-green-100 text-green-700 text-xs font-semibold px-2 py-0.5 rounded-full">' + data.online + ' en linea</span> ' +
        '<span class="bg-red-100 text-red-700 text-xs font-semibold px-2 py-0.5 rounded-full">' + data.offline.length + ' offline</span> ' +
        '<span class="text-xs text-gray-400">de ' + data.total + ageText + '</span>';

      if (data.offline.length === 0) {
        content.innerHTML = '<p class="text-sm text-green-600 text-center py-4"><i class="fas fa-check-circle mr-1"></i>Todos los clientes estan conectados</p>';
        return;
      }

      var html = '<div class="space-y-2">';
      data.offline.forEach(function(c) {
        html += '<div class="flex items-center justify-between p-3 bg-red-50 rounded-lg">' +
          '<div>' +
          '<a href="/clients/' + c.id + '" class="font-medium text-sm text-gray-800 hover:text-wisp-600">' + c.first_name + ' ' + c.last_name + '</a>' +
          '<p class="text-xs text-gray-500">' + (c.phone || '') + (c.plan_name ? ' &middot; ' + c.plan_name : '') + '</p>' +
          (c.pppoe_user ? '<p class="text-xs text-gray-400">PPPoE: ' + c.pppoe_user + '</p>' : '') +
          '</div>' +
          '<span class="bg-red-200 text-red-700 text-xs font-semibold px-2 py-0.5 rounded-full">Offline</span>' +
          '</div>';
      });
      html += '</div>';
      content.innerHTML = html;
    })
    .catch(function(err) {
      content.innerHTML = '<p class="text-sm text-red-400 text-center py-4">Error al conectar</p>';
    });
}
loadOfflineClients();
</script>

<!-- Plan Distribution -->
<div class="bg-white rounded-xl shadow-sm border mt-6">
  <div class="p-5 border-b">
    <h3 class="font-semibold text-gray-700"><i class="fas fa-chart-pie text-purple-500 mr-2"></i>Distribución por Plan</h3>
  </div>
  <div class="p-5">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% planDistribution.forEach(p => { %>
      <a href="/clients?plan_id=<%= p.id %>" class="text-center p-3 bg-gray-50 rounded-lg hover:bg-teal-50 hover:shadow-md transition-all cursor-pointer block">
        <p class="text-2xl font-bold text-teal-600"><%= p.count %></p>
        <p class="text-sm text-gray-600"><%= p.name %></p>
      </a>
      <% }) %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
