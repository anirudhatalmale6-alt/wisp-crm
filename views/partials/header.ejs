<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RYV Comunicaciones - CRM</title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0f766e">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="WISP CRM">
  <link rel="apple-touch-icon" href="/img/icon-192x192.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: { 50:'#eff6ff',100:'#dbeafe',200:'#bfdbfe',300:'#93c5fd',400:'#60a5fa',500:'#3b82f6',600:'#2563eb',700:'#1d4ed8',800:'#1e40af',900:'#1e3a8a' },
            wisp: { 50:'#f0fdfa',100:'#ccfbf1',200:'#99f6e4',300:'#5eead4',400:'#2dd4bf',500:'#14b8a6',600:'#0d9488',700:'#0f766e',800:'#115e59',900:'#134e4a' }
          }
        }
      }
    }
  </script>
  <style>
    .sidebar { transition: transform 0.3s ease; }
    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
<% if (user) { %>
<!-- Mobile menu button -->
<button onclick="document.getElementById('sidebar').classList.toggle('open')" class="md:hidden fixed top-4 left-4 z-50 bg-wisp-600 text-white p-2 rounded-lg shadow-lg">
  <i class="fas fa-bars"></i>
</button>

<!-- Sidebar -->
<aside id="sidebar" class="sidebar fixed left-0 top-0 h-full w-64 bg-wisp-800 text-white z-40 flex flex-col">
  <div class="p-4 border-b border-wisp-700">
    <div class="bg-white rounded-lg p-2 mb-2">
      <img src="/img/logo.png" alt="RYV Comunicaciones" class="h-10 w-auto mx-auto">
    </div>
    <p class="text-wisp-300 text-xs text-center">Panel de Control</p>
  </div>

  <nav class="flex-1 py-4 overflow-y-auto">
    <a href="/dashboard" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
      <i class="fas fa-chart-line w-5 text-center"></i> Dashboard
    </a>
    <a href="/clients" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'clients' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
      <i class="fas fa-users w-5 text-center"></i> Clientes
    </a>
    <a href="/plans" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'plans' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
      <i class="fas fa-cube w-5 text-center"></i> Planes
    </a>
    <a href="/invoices" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'invoices' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
      <i class="fas fa-file-invoice-dollar w-5 text-center"></i> Facturas
    </a>
    <a href="/payments" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'payments' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
      <i class="fas fa-money-bill-wave w-5 text-center"></i> Pagos
    </a>
    <a href="/whatsapp" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'whatsapp' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
      <i class="fab fa-whatsapp w-5 text-center"></i> WhatsApp
    </a>
    <a href="/mikrotik" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'mikrotik' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
      <i class="fas fa-network-wired w-5 text-center"></i> MikroTik
    </a>
    <a href="/onu" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'onu' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
      <i class="fas fa-broadcast-tower w-5 text-center"></i> ONUs
    </a>
    <a href="/map" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'map' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
      <i class="fas fa-map-marked-alt w-5 text-center"></i> Mapa
    </a>

    <div class="border-t border-wisp-700 mt-4 pt-4">
      <% if (user.role === 'admin') { %>
      <a href="/users" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'users' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
        <i class="fas fa-users-cog w-5 text-center"></i> Usuarios
      </a>
      <a href="/settings" class="flex items-center gap-3 px-5 py-3 hover:bg-wisp-700 transition-colors <%= typeof currentPage !== 'undefined' && currentPage === 'settings' ? 'bg-wisp-700 border-r-4 border-wisp-300' : '' %>">
        <i class="fas fa-cog w-5 text-center"></i> Configuración
      </a>
      <% } %>
    </div>
  </nav>

  <div class="p-4 border-t border-wisp-700">
    <div class="flex items-center justify-between">
      <span class="text-sm text-wisp-300"><i class="fas fa-user mr-1"></i> <%= user.name %> <span class="text-xs text-wisp-500">(<%= user.role === 'admin' ? 'Admin' : 'Secretaria' %>)</span></span>
      <a href="/logout" class="text-wisp-400 hover:text-white text-sm"><i class="fas fa-sign-out-alt"></i></a>
    </div>
  </div>
</aside>

<!-- Main content -->
<main class="md:ml-64 min-h-screen">
  <!-- Top bar -->
  <div class="bg-white shadow-sm border-b px-6 py-4 flex items-center justify-between gap-4">
    <h2 class="text-lg font-semibold text-gray-700 shrink-0"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h2>
    <div class="flex-1 max-w-md relative" id="globalSearchWrap">
      <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400"><i class="fas fa-search text-sm"></i></span>
      <input type="text" id="globalSearch" placeholder="Buscar cliente..." autocomplete="off"
        class="w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-wisp-500 focus:border-wisp-500 outline-none">
      <div id="globalSearchResults" class="hidden absolute z-50 left-0 right-0 top-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-72 overflow-y-auto"></div>
    </div>
    <div class="text-sm text-gray-500 hidden sm:block shrink-0"><%= new Date().toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></div>
  </div>
  <script>
  (function() {
    var input = document.getElementById('globalSearch');
    var box = document.getElementById('globalSearchResults');
    var timer;
    input.addEventListener('input', function() {
      clearTimeout(timer);
      var q = input.value.trim();
      if (q.length < 2) { box.classList.add('hidden'); return; }
      timer = setTimeout(function() {
        fetch('/clients/api/search?q=' + encodeURIComponent(q))
          .then(function(r) { return r.json(); })
          .then(function(clients) {
            if (!clients.length) { box.innerHTML = '<div class="p-3 text-sm text-gray-400">Sin resultados</div>'; box.classList.remove('hidden'); return; }
            box.innerHTML = clients.map(function(c) {
              var sc = c.status === 'active' ? 'bg-green-100 text-green-700' : c.status === 'suspended' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-600';
              return '<a href="/clients/' + c.id + '" class="flex items-center justify-between px-4 py-2.5 hover:bg-gray-50 border-b border-gray-100 last:border-0">' +
                '<div><span class="font-medium text-gray-800 text-sm">' + c.first_name + ' ' + c.last_name + '</span>' +
                '<span class="text-xs text-gray-400 ml-2">' + (c.phone || '') + '</span>' +
                (c.plan_name ? '<span class="text-xs text-wisp-600 ml-2">' + c.plan_name + '</span>' : '') +
                '</div>' +
                '<span class="text-xs font-semibold px-2 py-0.5 rounded-full ' + sc + '">' + (c.status === 'active' ? 'Activo' : c.status === 'suspended' ? 'Suspendido' : 'Inactivo') + '</span></a>';
            }).join('');
            box.classList.remove('hidden');
          });
      }, 250);
    });
    document.addEventListener('click', function(e) {
      if (!input.contains(e.target) && !box.contains(e.target)) box.classList.add('hidden');
    });
    input.addEventListener('focus', function() { if (box.innerHTML && input.value.trim().length >= 2) box.classList.remove('hidden'); });
  })();
  </script>

  <!-- Alerts -->
  <% if (success) { %>
  <div class="mx-6 mt-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center gap-2">
    <i class="fas fa-check-circle"></i> <%= success %>
  </div>
  <% } %>
  <% if (error) { %>
  <div class="mx-6 mt-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center gap-2">
    <i class="fas fa-exclamation-circle"></i> <%= error %>
  </div>
  <% } %>

  <div class="p-6">
<% } %>
