        <button onclick="changeWifi()" class="bg-purple-600 hover:bg-purple-700 text-white px-5 py-2 rounded-lg text-sm font-medium">
          <i class="fas fa-save mr-1"></i> Aplicar Cambios
        </button>
      </div>
      <div id="wifi-result" class="hidden text-sm p-3 rounded-lg"></div>
