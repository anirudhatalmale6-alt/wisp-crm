<script>
// ONU TR-069 functions
function refreshOnu(serial, svcId) {
  var statusEl = document.getElementById('onu-status-' + svcId);
  statusEl.textContent = 'Cargando...';
  statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-500';

  fetch('/onu/api/device/' + encodeURIComponent(serial))
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.error) {
        statusEl.textContent = 'No encontrada';
        statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-600';
        // Also update the inline info
        var inlineEl = document.querySelector('.onu-info-' + svcId);
        if (inlineEl) inlineEl.innerHTML = '<span class="text-red-400"><i class="fas fa-times-circle mr-1"></i>ONU no detectada en GenieACS</span>';
        return;
      }
      if (data.online) {
        statusEl.textContent = 'En linea';
        statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700';
      } else {
        statusEl.textContent = 'Desconectada';
        statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-600';
      }
      document.getElementById('onu-ssid-' + svcId).textContent = data.ssid || '-';
      document.getElementById('onu-wifipass-' + svcId).textContent = data.wifiPassword || '-';
      document.getElementById('onu-ip-' + svcId).textContent = data.ip || '-';
      document.getElementById('onu-mac-' + svcId).textContent = data.mac || '-';
      document.getElementById('onu-fw-' + svcId).textContent = (data.softwareVersion || '-') + ' / ' + (data.hardwareVersion || '-');

      // Optical power levels
      var rxEl = document.getElementById('onu-rx-' + svcId);
      var txEl = document.getElementById('onu-tx-' + svcId);
      if (data.rxPower) {
        rxEl.textContent = data.rxPower;
        // Color code based on power level
        var rxNum = parseFloat(data.rxPower);
        if (rxNum > -25) { rxEl.className = 'font-mono font-semibold text-green-600'; }
        else if (rxNum > -28) { rxEl.className = 'font-mono font-semibold text-yellow-600'; }
        else { rxEl.className = 'font-mono font-semibold text-red-600'; }
      } else {
        rxEl.textContent = 'No disponible';
        rxEl.className = 'font-mono text-gray-400 text-xs';
      }
      if (data.txPower) {
        txEl.textContent = data.txPower;
        txEl.className = 'font-mono font-semibold text-green-600';
      } else {
        txEl.textContent = 'No disponible';
        txEl.className = 'font-mono text-gray-400 text-xs';
      }

      // Hosts
      var hostsEl = document.getElementById('onu-hosts-' + svcId);
      if (data.hosts && data.hosts.length > 0) {
        var html = '<div class="space-y-1">';
        data.hosts.forEach(function(h) {
          html += '<div class="flex items-center gap-2"><i class="fas fa-laptop text-gray-400"></i> ' + (h.name || 'Sin nombre') + ' <span class="text-gray-400">(' + (h.ip || '') + ')</span></div>';
        });
        html += '</div>';
        hostsEl.innerHTML = html;
      } else {
        hostsEl.textContent = 'Sin dispositivos';
      }

      // Update inline info
      var inlineEl = document.querySelector('.onu-info-' + svcId);
      if (inlineEl) {
        var statusText = data.online ? '<span class="text-green-600"><i class="fas fa-circle text-xs mr-1"></i>En linea</span>' : '<span class="text-red-500"><i class="fas fa-circle text-xs mr-1"></i>Desconectada</span>';
        inlineEl.innerHTML = statusText + (data.ssid ? ' &middot; <span class="text-gray-500">' + data.ssid + '</span>' : '') + (data.hosts ? ' &middot; <span class="text-gray-400">' + data.hosts.length + ' dispositivos</span>' : '');
      }
    })
    .catch(function() {
      statusEl.textContent = 'Error';
      statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-600';
    });
}

function showWifiModal(serial, svcId) {
  document.getElementById('wifi-serial').value = serial;
  document.getElementById('wifi-svcid').value = svcId;
  document.getElementById('wifi-ssid').value = document.getElementById('onu-ssid-' + svcId).textContent;
  if (document.getElementById('wifi-ssid').value === '-') document.getElementById('wifi-ssid').value = '';
  document.getElementById('wifi-password').value = '';
  document.getElementById('wifi-result').classList.add('hidden');
  document.getElementById('wifi-modal').classList.remove('hidden');
}

function changeWifi() {
  var serial = document.getElementById('wifi-serial').value;
  var ssid = document.getElementById('wifi-ssid').value.trim();
  var password = document.getElementById('wifi-password').value.trim();
  var resultEl = document.getElementById('wifi-result');

  if (!ssid && !password) {
    resultEl.textContent = 'Debe especificar al menos un campo';
    resultEl.className = 'text-sm p-3 rounded-lg bg-red-50 text-red-600';
    resultEl.classList.remove('hidden');
    return;
  }

  resultEl.textContent = 'Enviando cambios...';
  resultEl.className = 'text-sm p-3 rounded-lg bg-blue-50 text-blue-600';
  resultEl.classList.remove('hidden');

  fetch('/onu/api/device/' + encodeURIComponent(serial) + '/wifi', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ssid: ssid || undefined, password: password || undefined })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.error) {
      resultEl.textContent = 'Error: ' + data.error;
      resultEl.className = 'text-sm p-3 rounded-lg bg-red-50 text-red-600';
    } else {
      resultEl.textContent = 'WiFi actualizado correctamente. Los cambios pueden tardar unos segundos en aplicarse.';
      resultEl.className = 'text-sm p-3 rounded-lg bg-green-50 text-green-600';
      var svcId = document.getElementById('wifi-svcid').value;
      setTimeout(function() { refreshOnu(serial, svcId); }, 5000);
    }
  })
  .catch(function() {
    resultEl.textContent = 'Error de conexion';
    resultEl.className = 'text-sm p-3 rounded-lg bg-red-50 text-red-600';
  });
}

function rebootOnu(serial, svcId) {
  if (!confirm('Reiniciar la ONU ' + serial + '? El cliente perdera conexion por unos minutos.')) return;

  var statusEl = document.getElementById('onu-status-' + svcId);
  statusEl.textContent = 'Reiniciando...';
  statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700';

  fetch('/onu/api/device/' + encodeURIComponent(serial) + '/reboot', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.error) {
      alert('Error: ' + data.error);
      statusEl.textContent = 'Error';
      statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-600';
    } else {
      statusEl.textContent = 'Reiniciando...';
      statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700';
      setTimeout(function() { refreshOnu(serial, svcId); }, 30000);
    }
  })
  .catch(function() {
    statusEl.textContent = 'Error';
    statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-600';
  });
}

function refreshOnuParams(serial, svcId) {
  var statusEl = document.getElementById('onu-status-' + svcId);
  statusEl.textContent = 'Actualizando...';
  statusEl.className = 'text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-600';

  fetch('/onu/api/device/' + encodeURIComponent(serial) + '/refresh', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.error) {
      alert('Error: ' + data.error);
      refreshOnu(serial, svcId);
    } else {
      statusEl.textContent = 'Esperando respuesta...';
      setTimeout(function() { refreshOnu(serial, svcId); }, 8000);
    }
  })
  .catch(function() {
    alert('Error de conexion');
    refreshOnu(serial, svcId);
  });
}

// Auto-load ONU info on page load
document.addEventListener('DOMContentLoaded', function() {
  <% onuServices.forEach(function(svc) { %>
  refreshOnu('<%= svc.onu_serial %>', <%= svc.id %>);
  <% }) %>
});
</script>
<% } %>

