<%- include('../partials/header', { currentPage: 'tickets', pageTitle: 'Ticket #' + ticket.id }) %>

<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
  <a href="/tickets" class="hover:text-wisp-600 transition-colors">Tickets</a>
  <i class="fas fa-chevron-right text-xs"></i>
  <span class="text-gray-700 font-medium">Ticket #<%= ticket.id %></span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Main Info -->
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-xl shadow-sm border">
      <div class="px-5 py-4 border-b bg-gray-50 rounded-t-xl flex items-center justify-between">
        <h3 class="font-semibold text-gray-700 flex items-center gap-2">
          <i class="fas fa-ticket-alt text-wisp-600"></i> <%= ticket.title %>
        </h3>
        <div class="flex items-center gap-2">
          <% if (ticket.priority === 'alta') { %>
            <span class="bg-red-100 text-red-700 text-xs font-semibold px-2 py-0.5 rounded-full">Alta</span>
          <% } else if (ticket.priority === 'media') { %>
            <span class="bg-yellow-100 text-yellow-700 text-xs font-semibold px-2 py-0.5 rounded-full">Media</span>
          <% } else { %>
            <span class="bg-blue-100 text-blue-700 text-xs font-semibold px-2 py-0.5 rounded-full">Baja</span>
          <% } %>
          <% if (ticket.status === 'abierto') { %>
            <span class="bg-red-100 text-red-700 text-xs font-semibold px-2 py-0.5 rounded-full">Abierto</span>
          <% } else if (ticket.status === 'en_progreso') { %>
            <span class="bg-yellow-100 text-yellow-700 text-xs font-semibold px-2 py-0.5 rounded-full">En Progreso</span>
          <% } else { %>
            <span class="bg-green-100 text-green-700 text-xs font-semibold px-2 py-0.5 rounded-full">Resuelto</span>
          <% } %>
        </div>
      </div>
      <div class="p-5">
        <% if (ticket.description) { %>
          <div class="text-sm text-gray-700 whitespace-pre-wrap mb-4"><%= ticket.description %></div>
        <% } else { %>
          <p class="text-sm text-gray-400 mb-4">Sin descripcion</p>
        <% } %>

        <% if (ticket.resolution_notes) { %>
          <div class="bg-green-50 border border-green-200 rounded-lg p-4 mt-4">
            <p class="text-xs font-semibold text-green-700 mb-1"><i class="fas fa-check-circle mr-1"></i>Resolucion:</p>
            <p class="text-sm text-green-800"><%= ticket.resolution_notes %></p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="space-y-6">
    <!-- Details -->
    <div class="bg-white rounded-xl shadow-sm border">
      <div class="px-5 py-4 border-b bg-gray-50 rounded-t-xl">
        <h3 class="font-semibold text-gray-700 text-sm">Detalles</h3>
      </div>
      <div class="p-5 space-y-3 text-sm">
        <div>
          <span class="text-gray-500">Cliente:</span>
          <% if (ticket.client_id) { %>
            <a href="/clients/<%= ticket.client_id %>" class="text-wisp-600 hover:text-wisp-700 font-medium ml-1"><%= ticket.first_name %> <%= ticket.last_name %></a>
            <% if (ticket.phone) { %><p class="text-xs text-gray-400 ml-1"><%= ticket.phone %></p><% } %>
            <% if (ticket.address) { %><p class="text-xs text-gray-400 ml-1"><i class="fas fa-map-marker-alt mr-1"></i><%= ticket.address %></p><% } %>
          <% } else { %>
            <span class="text-gray-400 ml-1">No asignado</span>
          <% } %>
        </div>
        <div>
          <span class="text-gray-500">Asignado a:</span>
          <span class="text-gray-800 ml-1"><%= ticket.assigned_to || 'Sin asignar' %></span>
        </div>
        <div>
          <span class="text-gray-500">Creado:</span>
          <span class="text-gray-800 ml-1"><%= ticket.created_at ? ticket.created_at.substring(0, 16).replace('T', ' ') : '' %></span>
        </div>
        <% if (ticket.resolved_at) { %>
        <div>
          <span class="text-gray-500">Resuelto:</span>
          <span class="text-gray-800 ml-1"><%= ticket.resolved_at.substring(0, 16).replace('T', ' ') %></span>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Actions -->
    <div class="bg-white rounded-xl shadow-sm border">
      <div class="px-5 py-4 border-b bg-gray-50 rounded-t-xl">
        <h3 class="font-semibold text-gray-700 text-sm">Acciones</h3>
      </div>
      <div class="p-5 space-y-2">
        <% if (ticket.status === 'abierto') { %>
          <form method="POST" action="/tickets/<%= ticket.id %>/status">
            <input type="hidden" name="status" value="en_progreso">
            <input type="hidden" name="redirect" value="/tickets/<%= ticket.id %>">
            <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
              <i class="fas fa-play-circle mr-1"></i> Marcar En Progreso
            </button>
          </form>
        <% } %>
        <% if (ticket.status !== 'resuelto') { %>
          <form method="POST" action="/tickets/<%= ticket.id %>/status">
            <input type="hidden" name="status" value="resuelto">
            <input type="hidden" name="redirect" value="/tickets/<%= ticket.id %>">
            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
              <i class="fas fa-check-circle mr-1"></i> Marcar Resuelto
            </button>
          </form>
        <% } %>
        <a href="/tickets/<%= ticket.id %>/edit" class="block w-full text-center bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          <i class="fas fa-edit mr-1"></i> Editar
        </a>
        <form method="POST" action="/tickets/<%= ticket.id %>/delete" onsubmit="return confirm('Seguro que desea eliminar este ticket?')">
          <button type="submit" class="w-full bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
            <i class="fas fa-trash mr-1"></i> Eliminar
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
