<%- include('../partials/header', { currentPage: 'onu', pageTitle: 'ONUs - GPON' }) %>

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
  <div>
    <h2 class="text-xl font-bold text-gray-800">Gestion de ONUs</h2>
    <p class="text-sm text-gray-500"><%= settings.olt_model || 'OLT' %> - <%= settings.olt_host || 'No configurada' %></p>
  </div>
  <div class="flex gap-2">
    <button onclick="snmpDiscover()" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">
      <i class="fas fa-search mr-1"></i> Descubrir ONUs (SNMP)
    </button>
    <button onclick="snmpTest()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">
      <i class="fas fa-plug mr-1"></i> Test SNMP
    </button>
    <button onclick="document.getElementById('cmdModal').classList.remove('hidden')" class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">
      <i class="fas fa-terminal mr-1"></i> Terminal SSH
    </button>
  </div>
</div>

<% if (error) { %>
<div class="bg-red-50 border border-red-200 rounded-xl p-5 mb-6">
  <div class="flex items-start gap-3">
    <i class="fas fa-exclamation-circle text-red-500 mt-0.5"></i>
    <div>
      <p class="font-medium text-red-700">Error</p>
      <p class="text-sm text-red-600 mt-1"><%= error %></p>
      <% if (!settings.olt_host) { %>
        <a href="/settings" class="inline-block mt-2 text-sm text-red-700 underline">Ir a Configuracion</a>
      <% } %>
    </div>
  </div>
</div>
<% } %>

<!-- SNMP Test Result -->
<div id="snmp-test-result" class="hidden mb-6"></div>

<!-- SNMP Stats -->
<div id="snmp-stats" class="hidden grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-xl shadow-sm border p-5 text-center">
    <p class="text-sm text-gray-500">Total ONUs</p>
    <p id="stat-total" class="text-3xl font-bold text-purple-600">0</p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border p-5 text-center">
    <p class="text-sm text-gray-500">En Linea</p>
    <p id="stat-online" class="text-3xl font-bold text-green-600">0</p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border p-5 text-center">
    <p class="text-sm text-gray-500">Asignadas en CRM</p>
    <p id="stat-assigned" class="text-3xl font-bold text-blue-600">0</p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border p-5 text-center">
    <p class="text-sm text-gray-500">Sin Asignar</p>
    <p id="stat-unassigned" class="text-3xl font-bold text-orange-600">0</p>
  </div>
</div>

<!-- New/Unassigned ONUs Section -->
<div id="snmp-new" class="hidden mb-6">
  <div class="bg-orange-50 rounded-xl shadow-sm border border-orange-200 overflow-hidden">
    <div class="px-5 py-4 border-b border-orange-200 bg-orange-100 flex items-center justify-between">
      <h3 class="font-semibold text-orange-800"><i class="fas fa-star text-orange-500 mr-2"></i>ONUs Nuevas / Sin Asignar <span id="new-count" class="text-sm font-normal text-orange-600"></span></h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-orange-600 border-b border-orange-200 bg-orange-50">
            <th class="px-3 py-3 font-medium">PON</th>
            <th class="px-3 py-3 font-medium">ONU ID</th>
            <th class="px-3 py-3 font-medium">Serial</th>
            <th class="px-3 py-3 font-medium">Modelo</th>
            <th class="px-3 py-3 font-medium">RX Power</th>
            <th class="px-3 py-3 font-medium">Ultima Conexion</th>
            <th class="px-3 py-3 font-medium">Estado</th>
            <th class="px-3 py-3 font-medium text-center">Acciones</th>
          </tr>
        </thead>
        <tbody id="snmp-new-tbody">
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- SNMP ONU Table -->
<div id="snmp-table" class="hidden bg-white rounded-xl shadow-sm border overflow-hidden mb-6">
  <div class="px-5 py-4 border-b bg-gray-50 flex items-center justify-between">
    <h3 class="font-semibold text-gray-700"><i class="fas fa-broadcast-tower text-purple-500 mr-2"></i>ONUs Asignadas <span id="assigned-count" class="text-sm font-normal text-gray-500"></span></h3>
    <div class="flex items-center gap-2">
      <input type="text" id="snmp-search" onkeyup="filterOnuTable()" placeholder="Buscar serial, modelo, cliente..."
        class="text-xs border border-gray-300 rounded-lg px-2 py-1 w-48">
      <select id="snmp-filter" onchange="filterOnuTable()" class="text-xs border border-gray-300 rounded-lg px-2 py-1">
        <option value="all">Todas</option>
        <option value="online">En linea</option>
        <option value="offline">Fuera de linea</option>
        <option value="assigned">Asignadas</option>
        <option value="unassigned">Sin asignar</option>
      </select>
    </div>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-gray-500 border-b bg-gray-50">
          <th class="px-3 py-3 font-medium">PON</th>
          <th class="px-3 py-3 font-medium">ONU ID</th>
          <th class="px-3 py-3 font-medium">Serial</th>
          <th class="px-3 py-3 font-medium">Modelo</th>
          <th class="px-3 py-3 font-medium">RX Power</th>
          <th class="px-3 py-3 font-medium">TX Power</th>
          <th class="px-3 py-3 font-medium">Estado</th>
          <th class="px-3 py-3 font-medium">Cliente</th>
          <th class="px-3 py-3 font-medium text-center">Acciones</th>
        </tr>
      </thead>
      <tbody id="snmp-tbody">
      </tbody>
    </table>
  </div>
</div>

<!-- Loading indicator -->
<div id="snmp-loading" class="hidden bg-white rounded-xl shadow-sm border p-10 text-center mb-6">
  <i class="fas fa-spinner fa-spin text-purple-500 text-3xl mb-3"></i>
  <p class="text-gray-500">Consultando OLT via SNMP...</p>
  <p class="text-xs text-gray-400 mt-1">Esto puede tardar unos segundos</p>
</div>

<!-- SNMP Error -->
<div id="snmp-error" class="hidden bg-red-50 border border-red-200 rounded-xl p-5 mb-6">
  <div class="flex items-start gap-3">
    <i class="fas fa-exclamation-circle text-red-500 mt-0.5"></i>
    <div>
      <p class="font-medium text-red-700">Error SNMP</p>
      <p id="snmp-error-msg" class="text-sm text-red-600 mt-1"></p>
    </div>
  </div>
</div>

<!-- Initial message if no discovery done -->
<div id="snmp-welcome" class="bg-white rounded-xl shadow-sm border p-10 text-center mb-6">
  <i class="fas fa-satellite-dish text-purple-300 text-5xl mb-4"></i>
  <h3 class="text-lg font-semibold text-gray-700 mb-2">Gestion de ONUs via SNMP</h3>
  <p class="text-sm text-gray-500 mb-4">Conecta con tu OLT para descubrir todas las ONUs automaticamente</p>
  <button onclick="snmpDiscover()" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2.5 rounded-lg text-sm font-medium transition-colors">
    <i class="fas fa-search mr-2"></i>Descubrir ONUs
  </button>
  <p class="text-xs text-gray-400 mt-3">OLT: <%= settings.olt_host || 'No configurada' %> | Community: <%= settings.snmp_community || 'public' %></p>
</div>

<!-- Terminal Modal -->
<div id="cmdModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] flex flex-col">
    <div class="px-5 py-4 border-b flex items-center justify-between">
      <h3 class="font-semibold text-gray-700"><i class="fas fa-terminal text-purple-500 mr-2"></i>Terminal OLT (SSH)</h3>
      <button onclick="document.getElementById('cmdModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-5 flex-1 overflow-y-auto">
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">Comando (uno por linea para multiples comandos)</label>
        <div class="flex gap-2">
          <textarea id="oltCommand" placeholder="show gpon onu state" rows="2"
            class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none resize-y"
            onkeydown="if(event.key==='Enter' && event.ctrlKey)sendCommand()"></textarea>
          <button onclick="sendCommand()" id="cmdSendBtn" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm transition-colors self-start">
            <i class="fas fa-play mr-1"></i> Ejecutar
          </button>
        </div>
        <p class="text-xs text-gray-400 mt-1">Ctrl+Enter para ejecutar</p>
      </div>
      <div class="mb-3">
        <p class="text-xs text-gray-400 mb-2">Comandos comunes:</p>
        <div class="flex flex-wrap gap-1">
          <button onclick="setCmd('?')" class="text-xs bg-purple-100 hover:bg-purple-200 text-purple-700 px-2 py-1 rounded font-bold">? (ayuda)</button>
          <button onclick="setCmd('show ?')" class="text-xs bg-purple-100 hover:bg-purple-200 text-purple-700 px-2 py-1 rounded">show ?</button>
          <button onclick="setCmd('enable\nshow gpon onu state')" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-600 px-2 py-1 rounded">enable + show gpon onu state</button>
          <button onclick="setCmd('show gpon onu state')" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-600 px-2 py-1 rounded">show gpon onu state</button>
          <button onclick="setCmd('show gpon onu-info all')" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-600 px-2 py-1 rounded">show gpon onu-info all</button>
          <button onclick="setCmd('show version')" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-600 px-2 py-1 rounded">show version</button>
        </div>
      </div>
      <div id="cmdOutput" class="bg-gray-900 text-green-400 p-4 rounded-lg text-xs min-h-[200px] max-h-96 overflow-y-auto font-mono whitespace-pre-wrap">
        Escriba un comando y presione Ejecutar...
      </div>
    </div>
  </div>
</div>

<!-- SNMP Walk Modal (debug) -->
<div id="walkModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] flex flex-col">
    <div class="px-5 py-4 border-b flex items-center justify-between">
      <h3 class="font-semibold text-gray-700"><i class="fas fa-search text-purple-500 mr-2"></i>SNMP Walk</h3>
      <button onclick="document.getElementById('walkModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-5 flex-1 overflow-y-auto">
      <div class="flex gap-2 mb-4">
        <input type="text" id="walkOid" placeholder="1.3.6.1.4.1.50224" value="1.3.6.1.4.1.50224.3.12.2.1.15"
          class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none">
        <button onclick="doSnmpWalk()" id="walkBtn" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">Walk</button>
      </div>
      <div id="walkOutput" class="bg-gray-900 text-green-400 p-4 rounded-lg text-xs min-h-[200px] max-h-96 overflow-y-auto font-mono whitespace-pre-wrap">
        Ingrese un OID y presione Walk...
      </div>
    </div>
  </div>
</div>

<!-- ONU Config Modal -->
<div id="configModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl w-full max-w-lg">
    <div class="px-5 py-4 border-b flex items-center justify-between">
      <h3 class="font-semibold text-gray-700"><i class="fas fa-cog text-purple-500 mr-2"></i>Configurar ONU</h3>
      <button onclick="closeConfig()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
    </div>
    <div class="p-5">
      <div class="flex items-center gap-3 mb-4 pb-3 border-b">
        <span class="text-sm text-gray-500">Serial:</span>
        <span id="cfgSerial" class="font-mono font-semibold text-gray-800"></span>
        <span class="text-sm text-gray-400">|</span>
        <span class="text-sm text-gray-500">ONU:</span>
        <span id="cfgOnuId" class="font-mono text-gray-800"></span>
      </div>

      <!-- Tabs -->
      <div class="flex gap-1 mb-4">
        <button onclick="showCfgTab('wifi')" id="tabWifi" class="px-4 py-2 text-sm font-medium rounded-lg bg-purple-100 text-purple-700">
          <i class="fas fa-wifi mr-1"></i> WiFi
        </button>
        <button onclick="showCfgTab('wan')" id="tabWan" class="px-4 py-2 text-sm font-medium rounded-lg text-gray-500 hover:bg-gray-100">
          <i class="fas fa-network-wired mr-1"></i> WAN / PPPoE
        </button>
      </div>

      <!-- WiFi Tab -->
      <div id="panelWifi">
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre WiFi (SSID)</label>
            <input type="text" id="cfgSsid" placeholder="Nombre de la red WiFi"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Clave WiFi</label>
            <div class="relative">
              <input type="text" id="cfgWifiPass" placeholder="Clave de la red WiFi"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none">
            </div>
          </div>
        </div>
        <div class="flex justify-end gap-2 mt-4">
          <button onclick="closeConfig()" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg">Cancelar</button>
          <button onclick="applyWifi()" id="btnApplyWifi" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
            <i class="fas fa-paper-plane mr-1"></i> Enviar WiFi
          </button>
        </div>
      </div>

      <!-- WAN Tab -->
      <div id="panelWan" class="hidden">
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Usuario PPPoE</label>
            <input type="text" id="cfgPppoeUser" placeholder="Usuario PPPoE"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Clave PPPoE</label>
            <input type="text" id="cfgPppoePass" placeholder="Clave PPPoE"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">VLAN ID (opcional)</label>
            <input type="text" id="cfgVlanId" placeholder="Ej: 100"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none">
          </div>
        </div>
        <div class="flex justify-end gap-2 mt-4">
          <button onclick="closeConfig()" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg">Cancelar</button>
          <button onclick="applyWan()" id="btnApplyWan" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
            <i class="fas fa-paper-plane mr-1"></i> Enviar PPPoE
          </button>
        </div>
      </div>

      <!-- Result -->
      <div id="cfgResult" class="hidden mt-3 p-3 rounded-lg text-sm"></div>
    </div>
  </div>
</div>

<!-- Assign ONU Modal -->
<div id="assignModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl w-full max-w-md">
    <div class="px-5 py-4 border-b flex items-center justify-between">
      <h3 class="font-semibold text-gray-700"><i class="fas fa-link text-blue-500 mr-2"></i>Asignar ONU a Cliente</h3>
      <button onclick="closeAssign()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
    </div>
    <div class="p-5">
      <p class="text-sm text-gray-600 mb-3">Serial: <span id="assignSerial" class="font-mono font-semibold"></span></p>
      <label class="block text-sm font-medium text-gray-700 mb-1">Seleccionar servicio del cliente</label>
      <select id="assignServiceId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none">
        <option value="">Cargando...</option>
      </select>
      <div class="flex justify-end gap-2 mt-4">
        <button onclick="closeAssign()" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg">Cancelar</button>
        <button onclick="doAssign()" id="assignBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium">Asignar</button>
      </div>
    </div>
  </div>
</div>

<script>
var allOnus = [];
var allServices = null;

function setCmd(cmd) {
  document.getElementById('oltCommand').value = cmd;
}

async function sendCommand() {
  var cmd = document.getElementById('oltCommand').value.trim();
  if (!cmd) return;
  var btn = document.getElementById('cmdSendBtn');
  var output = document.getElementById('cmdOutput');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Ejecutando...';
  output.textContent = 'Ejecutando: ' + cmd + '\n\nEsperando respuesta...';
  try {
    var resp = await fetch('/onu/api/command', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ command: cmd }) });
    var data = await resp.json();
    output.textContent = data.error ? 'Error: ' + data.error + '\n\n' + (data.output || '') : (data.output || '(sin salida)');
  } catch (e) { output.textContent = 'Error: ' + e.message; }
  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-play mr-1"></i> Ejecutar';
}

async function snmpTest() {
  var resultDiv = document.getElementById('snmp-test-result');
  resultDiv.className = 'mb-6 bg-blue-50 border border-blue-200 rounded-xl p-5';
  resultDiv.innerHTML = '<i class="fas fa-spinner fa-spin text-blue-500 mr-2"></i>Probando conexion SNMP...';

  try {
    var resp = await fetch('/onu/api/snmp/test');
    var data = await resp.json();
    if (data.success) {
      resultDiv.className = 'mb-6 bg-green-50 border border-green-200 rounded-xl p-5';
      resultDiv.innerHTML = '<div class="flex items-start gap-3"><i class="fas fa-check-circle text-green-500 mt-0.5"></i><div>' +
        '<p class="font-medium text-green-700">Conexion SNMP exitosa</p>' +
        '<p class="text-sm text-green-600 mt-1">' + data.description + '</p>' +
        '<p class="text-xs text-green-500 mt-1">' + data.message + '</p>' +
        '</div></div>';
    } else {
      resultDiv.className = 'mb-6 bg-red-50 border border-red-200 rounded-xl p-5';
      resultDiv.innerHTML = '<div class="flex items-start gap-3"><i class="fas fa-times-circle text-red-500 mt-0.5"></i><div>' +
        '<p class="font-medium text-red-700">Error de conexion SNMP</p>' +
        '<p class="text-sm text-red-600 mt-1">' + data.error + '</p>' +
        '</div></div>';
    }
  } catch (e) {
    resultDiv.className = 'mb-6 bg-red-50 border border-red-200 rounded-xl p-5';
    resultDiv.innerHTML = '<p class="text-red-600">Error: ' + e.message + '</p>';
  }
}

async function snmpDiscover() {
  document.getElementById('snmp-welcome').classList.add('hidden');
  document.getElementById('snmp-error').classList.add('hidden');
  document.getElementById('snmp-table').classList.add('hidden');
  document.getElementById('snmp-stats').classList.add('hidden');
  document.getElementById('snmp-loading').classList.remove('hidden');

  try {
    var resp = await fetch('/onu/api/snmp/discover');
    var data = await resp.json();
    document.getElementById('snmp-loading').classList.add('hidden');

    if (data.error) {
      document.getElementById('snmp-error').classList.remove('hidden');
      document.getElementById('snmp-error-msg').textContent = data.error;
      if (data.onus && data.onus.length === 0) return;
    }

    allOnus = data.onus || [];

    if (allOnus.length === 0) {
      document.getElementById('snmp-error').classList.remove('hidden');
      document.getElementById('snmp-error-msg').textContent = 'No se encontraron ONUs. Verifique que SNMP este habilitado en la OLT y que el community sea correcto.';
      return;
    }

    // Update stats
    document.getElementById('stat-total').textContent = allOnus.length;
    document.getElementById('stat-online').textContent = allOnus.filter(function(o) { return o.status === 'online'; }).length;
    document.getElementById('stat-assigned').textContent = allOnus.filter(function(o) { return o.assigned; }).length;
    document.getElementById('stat-unassigned').textContent = allOnus.filter(function(o) { return !o.assigned; }).length;
    document.getElementById('snmp-stats').classList.remove('hidden');

    renderOnuTable(allOnus);
    renderNewOnus(allOnus);
    document.getElementById('assigned-count').textContent = '(' + allOnus.filter(function(o) { return o.assigned; }).length + ')';
    document.getElementById('snmp-table').classList.remove('hidden');

  } catch (e) {
    document.getElementById('snmp-loading').classList.add('hidden');
    document.getElementById('snmp-error').classList.remove('hidden');
    document.getElementById('snmp-error-msg').textContent = 'Error: ' + e.message;
  }
}

function renderOnuTable(onus) {
  var tbody = document.getElementById('snmp-tbody');
  var html = '';
  onus.forEach(function(onu) {
    var rxClass = '';
    if (onu.rxDbm !== null && onu.rxDbm !== undefined) {
      if (onu.rxDbm > -25) rxClass = 'text-green-600 font-semibold';
      else if (onu.rxDbm > -28) rxClass = 'text-yellow-600 font-semibold';
      else rxClass = 'text-red-600 font-semibold';
    }
    var txClass = '';
    if (onu.txDbm !== null && onu.txDbm !== undefined) {
      if (onu.txDbm > 0 && onu.txDbm < 5) txClass = 'text-green-600';
      else txClass = 'text-gray-500';
    }

    var modelStr = onu.model || '';
    if (onu.vendor && onu.vendor !== onu.model) modelStr = (onu.vendor + ' ' + modelStr).trim();

    html += '<tr class="border-b border-gray-100 hover:bg-gray-50 onu-row" data-assigned="' + (onu.assigned ? 'yes' : 'no') + '" data-status="' + onu.status + '">';
    html += '<td class="px-3 py-2.5 font-mono text-xs">' + (onu.ponPort || '-') + '</td>';
    html += '<td class="px-3 py-2.5 font-mono text-xs">' + (onu.onuId || '-') + '</td>';
    html += '<td class="px-3 py-2.5 font-mono text-xs">' + (onu.serial || '-') + '</td>';
    html += '<td class="px-3 py-2.5 text-xs text-gray-600">' + (modelStr || '-') + '</td>';
    html += '<td class="px-3 py-2.5 font-mono text-xs ' + rxClass + '">' + (onu.rxPower || '-') + '</td>';
    html += '<td class="px-3 py-2.5 font-mono text-xs ' + txClass + '">' + (onu.txPower || '-') + '</td>';
    html += '<td class="px-3 py-2.5">';
    if (onu.status === 'online') {
      html += '<span class="inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded-full"><span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>Online</span>';
    } else {
      html += '<span class="inline-flex items-center gap-1 bg-red-100 text-red-600 text-xs font-medium px-2 py-0.5 rounded-full"><span class="w-1.5 h-1.5 bg-red-400 rounded-full"></span>Offline</span>';
    }
    html += '</td>';
    html += '<td class="px-3 py-2.5 text-xs">';
    if (onu.assigned) {
      html += '<a href="/clients/' + onu.clientId + '" class="text-wisp-600 hover:text-wisp-700 font-medium"><i class="fas fa-user mr-1"></i>' + onu.clientName + '</a>';
      if (onu.pppoeUser) html += '<br><span class="text-gray-400 font-mono">' + onu.pppoeUser + '</span>';
    } else {
      html += '<button onclick="openAssign(\'' + onu.serial + '\')" class="text-blue-500 hover:text-blue-700 text-xs"><i class="fas fa-link mr-1"></i>Asignar</button>';
    }
    html += '</td>';
    html += '<td class="px-3 py-2.5 text-center">';
    html += '<div class="flex items-center justify-center gap-1">';
    html += '<button onclick="openConfig(\'' + onu.serial + '\', \'' + (onu.onuId || '') + '\', ' + (onu.ponPort || 0) + ', \'' + (onu.index || '') + '\')" class="text-purple-500 hover:text-purple-700 p-1" title="Configurar WiFi/PPPoE"><i class="fas fa-cog text-xs"></i></button>';
    html += '<button onclick="rebootOnu(\'' + onu.index + '\', \'' + onu.serial + '\')" class="text-orange-500 hover:text-orange-700 p-1" title="Reiniciar ONU"><i class="fas fa-sync-alt text-xs"></i></button>';
    if (onu.assigned) {
      html += '<button onclick="unassignOnu(\'' + onu.serial + '\')" class="text-red-400 hover:text-red-600 p-1" title="Desasignar"><i class="fas fa-unlink text-xs"></i></button>';
    }
    html += '</div>';
    html += '</td>';
    html += '</tr>';
  });
  tbody.innerHTML = html;
}

function renderNewOnus(onus) {
  var unassigned = onus.filter(function(o) { return !o.assigned; });
  var section = document.getElementById('snmp-new');

  if (unassigned.length === 0) {
    section.classList.add('hidden');
    return;
  }

  // Sort by lastSeen descending (newest first)
  unassigned.sort(function(a, b) {
    if (!a.lastSeen && !b.lastSeen) return 0;
    if (!a.lastSeen) return 1;
    if (!b.lastSeen) return -1;
    return b.lastSeen.localeCompare(a.lastSeen);
  });

  document.getElementById('new-count').textContent = '(' + unassigned.length + ')';
  var tbody = document.getElementById('snmp-new-tbody');
  var html = '';

  unassigned.forEach(function(onu) {
    var rxClass = '';
    if (onu.rxDbm !== null && onu.rxDbm !== undefined) {
      if (onu.rxDbm > -25) rxClass = 'text-green-600 font-semibold';
      else if (onu.rxDbm > -28) rxClass = 'text-yellow-600 font-semibold';
      else rxClass = 'text-red-600 font-semibold';
    }

    var modelStr = onu.model || '';
    if (onu.vendor && onu.vendor !== onu.model) modelStr = (onu.vendor + ' ' + modelStr).trim();

    html += '<tr class="border-b border-orange-100 hover:bg-orange-50">';
    html += '<td class="px-3 py-2.5 font-mono text-xs">' + (onu.ponPort || '-') + '</td>';
    html += '<td class="px-3 py-2.5 font-mono text-xs">' + (onu.onuId || '-') + '</td>';
    html += '<td class="px-3 py-2.5 font-mono text-xs font-semibold text-orange-700">' + (onu.serial || '-') + '</td>';
    html += '<td class="px-3 py-2.5 text-xs text-gray-600">' + (modelStr || '-') + '</td>';
    html += '<td class="px-3 py-2.5 font-mono text-xs ' + rxClass + '">' + (onu.rxPower || '-') + '</td>';
    html += '<td class="px-3 py-2.5 text-xs text-gray-500">' + (onu.lastSeen || '-') + '</td>';
    html += '<td class="px-3 py-2.5">';
    if (onu.status === 'online') {
      html += '<span class="inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded-full"><span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>Online</span>';
    } else {
      html += '<span class="inline-flex items-center gap-1 bg-red-100 text-red-600 text-xs font-medium px-2 py-0.5 rounded-full"><span class="w-1.5 h-1.5 bg-red-400 rounded-full"></span>Offline</span>';
    }
    html += '</td>';
    html += '<td class="px-3 py-2.5 text-center">';
    html += '<div class="flex items-center justify-center gap-1">';
    html += '<button onclick="openConfig(\'' + onu.serial + '\', \'' + (onu.onuId || '') + '\', ' + (onu.ponPort || 0) + ', \'' + (onu.index || '') + '\')" class="text-purple-500 hover:text-purple-700 p-1" title="Configurar WiFi/PPPoE"><i class="fas fa-cog text-xs"></i></button>';
    html += '<button onclick="openAssign(\'' + onu.serial + '\')" class="bg-blue-500 hover:bg-blue-600 text-white px-2 py-1 rounded text-xs font-medium"><i class="fas fa-link mr-1"></i>Asignar</button>';
    html += '<button onclick="rebootOnu(\'' + onu.index + '\', \'' + onu.serial + '\')" class="text-orange-500 hover:text-orange-700 p-1" title="Reiniciar ONU"><i class="fas fa-sync-alt text-xs"></i></button>';
    html += '</div>';
    html += '</td>';
    html += '</tr>';
  });

  tbody.innerHTML = html;
  section.classList.remove('hidden');
}

function filterOnuTable() {
  var filter = document.getElementById('snmp-filter').value;
  var search = (document.getElementById('snmp-search').value || '').toLowerCase().trim();
  var filtered = allOnus;
  if (filter === 'online') filtered = filtered.filter(function(o) { return o.status === 'online'; });
  else if (filter === 'offline') filtered = filtered.filter(function(o) { return o.status === 'offline'; });
  else if (filter === 'assigned') filtered = filtered.filter(function(o) { return o.assigned; });
  else if (filter === 'unassigned') filtered = filtered.filter(function(o) { return !o.assigned; });
  if (search) {
    filtered = filtered.filter(function(o) {
      return (o.serial || '').toLowerCase().indexOf(search) >= 0 ||
        (o.model || '').toLowerCase().indexOf(search) >= 0 ||
        (o.vendor || '').toLowerCase().indexOf(search) >= 0 ||
        (o.clientName || '').toLowerCase().indexOf(search) >= 0 ||
        (o.pppoeUser || '').toLowerCase().indexOf(search) >= 0 ||
        (o.onuId || '').toLowerCase().indexOf(search) >= 0;
    });
  }
  renderOnuTable(filtered);
}

async function doSnmpWalk() {
  var oid = document.getElementById('walkOid').value.trim();
  if (!oid) return;
  var btn = document.getElementById('walkBtn');
  var output = document.getElementById('walkOutput');
  btn.disabled = true;
  btn.textContent = 'Walking...';
  output.textContent = 'Walking OID: ' + oid + '...\n';
  try {
    var resp = await fetch('/onu/api/snmp/walk?oid=' + encodeURIComponent(oid));
    var data = await resp.json();
    if (data.error) {
      output.textContent = 'Error: ' + data.error;
    } else {
      var text = 'Resultados: ' + data.count + ' OIDs\n\n';
      (data.results || []).forEach(function(r) { text += r.oid + ' = ' + r.value + '\n'; });
      output.textContent = text;
    }
  } catch (e) { output.textContent = 'Error: ' + e.message; }
  btn.disabled = false;
  btn.textContent = 'Walk';
}

async function rebootOnu(index, serial) {
  if (!confirm('Reiniciar la ONU ' + serial + '?\nLa ONU se desconectara por unos segundos.')) return;
  try {
    var resp = await fetch('/onu/api/snmp/reboot/' + index, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    var data = await resp.json();
    if (data.success) {
      alert('Comando de reinicio enviado a ' + serial);
    } else {
      alert('Error: ' + (data.error || 'No se pudo reiniciar'));
    }
  } catch (e) { alert('Error: ' + e.message); }
}

async function openAssign(serial) {
  document.getElementById('assignSerial').textContent = serial;
  document.getElementById('assignModal').classList.remove('hidden');
  var select = document.getElementById('assignServiceId');
  select.innerHTML = '<option value="">Cargando...</option>';

  if (!allServices) {
    try {
      var resp = await fetch('/onu/api/snmp/clients');
      var data = await resp.json();
      allServices = data.services || [];
    } catch (e) {
      select.innerHTML = '<option value="">Error cargando clientes</option>';
      return;
    }
  }

  var html = '<option value="">-- Seleccionar servicio --</option>';
  allServices.forEach(function(s) {
    var label = '';
    if (s.pppoe_user) label = s.pppoe_user + ' | ';
    label += s.first_name + ' ' + s.last_name;
    if (s.plan_name) label += ' - ' + s.plan_name;
    if (s.onu_serial) label += ' [ONU: ' + s.onu_serial + ']';
    html += '<option value="' + s.service_id + '"' + (s.onu_serial ? ' style="color:#999"' : '') + '>' + label + '</option>';
  });
  select.innerHTML = html;
}

function closeAssign() {
  document.getElementById('assignModal').classList.add('hidden');
}

async function doAssign() {
  var serial = document.getElementById('assignSerial').textContent;
  var serviceId = document.getElementById('assignServiceId').value;
  if (!serviceId) { alert('Seleccione un servicio'); return; }

  try {
    var resp = await fetch('/onu/api/snmp/assign', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ serial: serial, serviceId: serviceId })
    });
    var data = await resp.json();
    if (data.success) {
      closeAssign();
      allServices = null;
      snmpDiscover();
    } else {
      alert('Error: ' + (data.error || 'No se pudo asignar'));
    }
  } catch (e) { alert('Error: ' + e.message); }
}

async function unassignOnu(serial) {
  if (!confirm('Desasignar la ONU ' + serial + ' del cliente?')) return;
  try {
    var resp = await fetch('/onu/api/snmp/unassign', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ serial: serial })
    });
    var data = await resp.json();
    if (data.success) {
      allServices = null;
      snmpDiscover();
    } else {
      alert('Error: ' + (data.error || 'No se pudo desasignar'));
    }
  } catch (e) { alert('Error: ' + e.message); }
}

// ========== ONU Configuration (WiFi/PPPoE via OLT Web) ==========

var currentCfgOnu = {};

function openConfig(serial, onuId, ponPort, index) {
  currentCfgOnu = { serial: serial, onuId: onuId, ponPort: ponPort, index: index };
  document.getElementById('cfgSerial').textContent = serial;
  document.getElementById('cfgOnuId').textContent = onuId || 'PON' + ponPort;
  document.getElementById('cfgSsid').value = '';
  document.getElementById('cfgWifiPass').value = '';
  document.getElementById('cfgPppoeUser').value = '';
  document.getElementById('cfgPppoePass').value = '';
  document.getElementById('cfgVlanId').value = '';
  document.getElementById('cfgResult').classList.add('hidden');
  showCfgTab('wifi');

  // Pre-fill PPPoE user if ONU is assigned to a client
  var onu = allOnus.find(function(o) { return o.serial === serial; });
  if (onu && onu.pppoeUser) {
    document.getElementById('cfgPppoeUser').value = onu.pppoeUser;
  }

  document.getElementById('configModal').classList.remove('hidden');
}

function closeConfig() {
  document.getElementById('configModal').classList.add('hidden');
}

function showCfgTab(tab) {
  document.getElementById('panelWifi').classList.toggle('hidden', tab !== 'wifi');
  document.getElementById('panelWan').classList.toggle('hidden', tab !== 'wan');
  document.getElementById('tabWifi').className = tab === 'wifi'
    ? 'px-4 py-2 text-sm font-medium rounded-lg bg-purple-100 text-purple-700'
    : 'px-4 py-2 text-sm font-medium rounded-lg text-gray-500 hover:bg-gray-100';
  document.getElementById('tabWan').className = tab === 'wan'
    ? 'px-4 py-2 text-sm font-medium rounded-lg bg-blue-100 text-blue-700'
    : 'px-4 py-2 text-sm font-medium rounded-lg text-gray-500 hover:bg-gray-100';
  document.getElementById('cfgResult').classList.add('hidden');
}

function showCfgResult(success, msg) {
  var el = document.getElementById('cfgResult');
  el.className = success
    ? 'mt-3 p-3 rounded-lg text-sm bg-green-50 border border-green-200 text-green-700'
    : 'mt-3 p-3 rounded-lg text-sm bg-red-50 border border-red-200 text-red-700';
  el.innerHTML = (success ? '<i class="fas fa-check-circle mr-1"></i>' : '<i class="fas fa-exclamation-circle mr-1"></i>') + msg;
  el.classList.remove('hidden');
}

// Parse ONU ID to get the ont_id number (e.g., "ONT01/003" -> "3")
function parseOntId(onuId) {
  var m = onuId.match(/ONT\d+\/(\d+)/);
  return m ? parseInt(m[1]) : 0;
}

async function applyWifi() {
  var ssid = document.getElementById('cfgSsid').value.trim();
  var shareKey = document.getElementById('cfgWifiPass').value.trim();
  if (!ssid) { showCfgResult(false, 'Ingrese el nombre WiFi (SSID)'); return; }
  if (shareKey && shareKey.length < 8) { showCfgResult(false, 'La clave WiFi debe tener al menos 8 caracteres'); return; }

  var btn = document.getElementById('btnApplyWifi');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Enviando...';

  try {
    var resp = await fetch('/onu/api/olt/wlan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        port_id: String(currentCfgOnu.ponPort || 0),
        ont_id: String(parseOntId(currentCfgOnu.onuId)),
        ssid: ssid,
        share_key: shareKey
      })
    });
    var data = await resp.json();
    if (data.success) {
      showCfgResult(true, 'Configuracion WiFi enviada a la ONU. SSID: ' + ssid);
    } else {
      showCfgResult(false, 'Error: ' + (data.error || 'No se pudo enviar la configuracion'));
    }
  } catch (e) {
    showCfgResult(false, 'Error de conexion: ' + e.message);
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-paper-plane mr-1"></i> Enviar WiFi';
}

async function applyWan() {
  var pppoeUser = document.getElementById('cfgPppoeUser').value.trim();
  var pppoePass = document.getElementById('cfgPppoePass').value.trim();
  var vlanId = document.getElementById('cfgVlanId').value.trim();
  if (!pppoeUser) { showCfgResult(false, 'Ingrese el usuario PPPoE'); return; }

  var btn = document.getElementById('btnApplyWan');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Enviando...';

  try {
    var resp = await fetch('/onu/api/olt/wan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        port_id: String(currentCfgOnu.ponPort || 0),
        ont_id: String(parseOntId(currentCfgOnu.onuId)),
        pppoe_user: pppoeUser,
        pppoe_pass: pppoePass,
        vlan_id: vlanId
      })
    });
    var data = await resp.json();
    if (data.success) {
      showCfgResult(true, 'Configuracion PPPoE enviada a la ONU. Usuario: ' + pppoeUser);
    } else {
      showCfgResult(false, 'Error: ' + (data.error || 'No se pudo enviar la configuracion'));
    }
  } catch (e) {
    showCfgResult(false, 'Error de conexion: ' + e.message);
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-paper-plane mr-1"></i> Enviar PPPoE';
}
</script>

